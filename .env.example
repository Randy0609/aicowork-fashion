# 默认使用模拟引擎，不需要 API Key。
AICOWORK_PROVIDER=demo

# 使用兼容 /v1/chat/completions 的模型服务时，改成 openai-compatible。
# AICOWORK_PROVIDER=openai-compatible
AICOWORK_BASE_URL=https://api.openai.com/v1
AICOWORK_API_KEY=
AICOWORK_MODEL=

# 可选：修改本地数据和跨域配置。
# AICOWORK_DATA_DIR=./runtime
# AICOWORK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
